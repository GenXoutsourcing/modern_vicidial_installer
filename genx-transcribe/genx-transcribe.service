[Unit]
Description=GenX transcription worker (faster-whisper CPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/genx-transcribe.env
ExecStart=/opt/genx-transcribe/venv/bin/python /opt/genx-transcribe/genx_transcribe.py
Restart=always
RestartSec=15
Nice=10
User=root

[Install]
WantedBy=multi-user.target
